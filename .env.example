# Set this to the final production origin before deployment so canonical URLs,
# the sitemap, robots.txt, and social metadata use the public domain.
NEXT_PUBLIC_SITE_URL=https://portfolio.example.com

# Contact-form delivery. Keep RESEND_API_KEY secret and set it only in your
# local .env.local file or deployment environment.
RESEND_API_KEY=
CONTACT_TO_EMAIL=yashroushan@dal.ca
# Optional after verifying your own sending domain with Resend. If omitted,
# the form uses Resend's testing sender, which only delivers to your account email.
CONTACT_FROM_EMAIL=
